# Nightjar SOC configuration. Copy to .env (make setup does). Every value has a working offline default.

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=dev
PUBLIC_APP_URL=http://localhost:3030
CORS_ORIGINS=["http://localhost:3030"]
LOG_LEVEL=INFO
LOG_JSON=false
# Demo clock: read every "today"/"now" as of this date (seed, clocks, copy). Empty = real time.
# Portfolio screenshots use a date inside the history window, e.g. 2025-11-20.
NIGHTJAR_DEMO_TODAY=
# Optional time of day for the demo clock (Europe/Brussels), e.g. 10:00, so "last night" does not depend on when
# you seed or look. Seed/reset fix the shared anchor in data/demo-clock.json; every process reads it.
NIGHTJAR_DEMO_TIME=
NIGHTJAR_DEMO_TZ=Europe/Brussels

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=dev-insecure-change-me-0123456789abcdef
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
INGEST_RATE_LIMIT_PER_MINUTE=600

# ── App database (run processes from backend/) ───────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./nightjar-dev.db
# DATABASE_URL=postgresql+asyncpg://nightjar:nightjar@localhost:5432/nightjar   # pip install ".[postgres]"

# ── Event backbone ───────────────────────────────────────────────────────────
BUS=nats                       # nats | memory (single process, tests)
NATS_URL=nats://127.0.0.1:4230

# ── Agents and tool servers ──────────────────────────────────────────────────
AGENTS_TRANSPORT=http          # http | inline (in-process, tests and single-process demo)
AGENT_TRIAGE_URL=http://127.0.0.1:8031
AGENT_ENRICHMENT_URL=http://127.0.0.1:8032
AGENT_RESPONSE_URL=http://127.0.0.1:8033
MCP_URL=http://127.0.0.1:8034
APPROVAL_TTL_MINUTES=60

# ── Text generation (offline fake by default; no keys needed) ────────────────
LLM_FAKE=true
LLM_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Data, intel, rules, models ───────────────────────────────────────────────
INTEL_SOURCE=bundled           # bundled | downloaded (make data)
RULES_SOURCE=bundled           # bundled | downloaded
MLFLOW_DISABLE_AGENT_HINT=1
