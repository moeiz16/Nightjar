{
  "name": "nightjar-soc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev --port 3030 --strictPort",
    "dev:mock": "PUBLIC_API_MOCK=1 vite dev --port 3030 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3030 --strictPort",
    "preview:mock": "PUBLIC_API_MOCK=1 vite preview --port 3030 --strictPort",
    "start": "PORT=3030 node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "5.2.5",
    "@fontsource-variable/fira-code": "5.2.7",
    "@fontsource-variable/manrope": "5.2.8",
    "@skeletonlabs/skeleton": "3.2.2",
    "@skeletonlabs/skeleton-svelte": "1.5.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@sveltejs/adapter-node": "5.5.8",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "jsdom": "25.0.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.1.18",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
